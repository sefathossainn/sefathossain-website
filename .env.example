# Copy to .env.local (local) or set in Vercel Project Settings (production).
# NEVER commit real values. The service-role key is server-only.

# Public site origin — used for canonical URLs, metadata, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://sefathossain.com

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY. Bypasses RLS. Never expose to the client bundle,
# never prefix with NEXT_PUBLIC_. Rotate if it has ever been shared.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — lead-notification email (Resend) and booking calendar embed.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@sefathossain.com
NEXT_PUBLIC_CALENDAR_URL=

# One-time super-admin seed. DO NOT store this here — pass it inline only when
# running the seed, then rotate it after first login:
#   SEED_ADMIN_PASSWORD='your-temp-password' npm run seed:admin
# SEED_ADMIN_PASSWORD=
